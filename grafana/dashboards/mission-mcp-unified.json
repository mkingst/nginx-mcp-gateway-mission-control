{
  "id": null,
  "uid": "mission-mcp-json",
  "title": "Mission Control \u2014 NGINX MCP Observability (JSON)",
  "tags": [
    "nginx",
    "mcp",
    "official-nginx-derived"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool popularity \u2014 calls/s (official)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_tool_name) (rate(edge_calls_total[1m]))",
          "legendFormat": "{{gen_ai_tool_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool popularity \u2014 calls in last 15m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name) (increase(edge_calls_total{gen_ai_tool_name!=\"\"}[15m]))",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "P95 HTTP latency by MCP tool (ms)",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(edge_duration_milliseconds_bucket{gen_ai_tool_name!=\"\"}[5m])))",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "P99 HTTP latency by MCP tool (ms)",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, gen_ai_tool_name) (rate(edge_duration_milliseconds_bucket{gen_ai_tool_name!=\"\"}[5m])))",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
