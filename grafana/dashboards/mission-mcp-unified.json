      "targets": [
        {
          "expr": "sum by (mcp_outcome) (increase(edge_calls_total{mcp_outcome!=\"\"}[15m]))",
          "legendFormat": "{{mcp_outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "MCP errors under HTTP 200 \u2014 last 15m",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "axisLabel": "errors/s"
          }
        },
        "overrides": []
