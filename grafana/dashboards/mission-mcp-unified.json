      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 9,
      "title": "MCP semantic outcomes \u2014 last 15m",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "axisLabel": "responses/s"
