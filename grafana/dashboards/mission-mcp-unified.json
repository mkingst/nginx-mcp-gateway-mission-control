        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "title": "P99 HTTP latency by backend (official)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, mcp_backend_name) (rate(edge_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{mcp_backend_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP status \u2014 includes NGINX denials (official)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (http_status_code) (rate(edge_calls_total[1m]))",
          "legendFormat": "HTTP {{http_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Blocked tool attempts \u2014 last 15m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mcp_tool_attempted) (increase(edge_calls_total{mcp_policy=\"blocked\"}[15m]))",
          "legendFormat": "{{mcp_tool_attempted}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 429 throttled requests \u2014 last 15m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(edge_calls_total{http_status_code=\"429\"}[15m]))",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
