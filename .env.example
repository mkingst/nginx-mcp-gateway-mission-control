# Copy to .env and replace this with a unique password (at least 5 characters).
# The placeholder below is rejected by the UI, so the config editor stays disabled until you change it.
# Do not commit .env. The editor is for a trusted, isolated demo environment only.
NGINX_EDITOR_TOKEN=change-this-demo-password

# Interface that published ports bind to. Default 127.0.0.1 (this machine only).
# DEMO_BIND=0.0.0.0

# Host ports. Change any that are already in use on this machine.
# GATEWAY_PORT=8080
# UI_PORT=3000
# MCP_DIRECT_PORT=8001
# GRAFANA_PORT=3002
# PROMETHEUS_PORT=9090
